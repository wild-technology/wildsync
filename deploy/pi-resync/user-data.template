#cloud-config
# Wild Sync node re-provision: re-applies the ssh user and the rig's chrony
# topology to a node whose card has already booted. The clock reference is the
# GNSS Compass on the rig switch (GNSS_NTP below: a stratum-1 NTP server on GPS
# time), under either host; the peer mesh is the fallback when it is off, and
# `deploy.sh node`, run from a Jetson host, adds that Jetson as a further
# server. Written for the 2026-08-23 Mac host; the chrony step was generalized
# from two nodes to N on 2026-08-27 and given the Compass on 2026-10-15.
# `deploy.sh clock camN` applies the same topology to a node whose card never
# ran this step.
#
# Drop this on a node's system-boot partition as `user-data` together with a
# NEW instance-id in `meta-data` (see install.sh). cloud-init re-runs its
# per-instance modules on the next boot and:
#   * adds this host's SSH key alongside the one already on the card (password
#     unchanged);
#   * writes the rig clock topology (docs/INSTALL.md 5). Every node gets the
#     SAME config: the GNSS Compass as its preferred server, plus a full mesh
#     of chrony peers and an orphan local reference, so that with the Compass
#     off chrony elects one master by comparing NTP reference IDs. chrony.conf
#     is made to step ANY error over 1 s (`makestep 1 -1`): a Pi has no RTC
#     battery, so after a power cycle it boots days in the past and must step
#     the moment a reference answers, however many updates it has already
#     made. The Ubuntu pool in /etc/chrony/chrony.conf is untouched and still
#     wins whenever the boat has internet.
# The hostname is kept (a named card is written back as hostname:, an unnamed
# one keeps the image default) and no packages are touched or upgraded.
#
# The chrony step is identical on every card: it derives its own slot from the
# hostname (pi-camN) and needs no per-node editing. Adding cam4 is one entry in
# SLOTS below.
#
# Placeholders (install.sh fills them from the card itself and ~/.ssh):
#   __PASSWD_HASH__   the existing `passwd:` value on the card (unchanged)
#   __CARD_KEY__      the existing ssh-ed25519 line on the card (kept)
#   __HOST_KEY__      this host's ~/.ssh/id_ed25519.pub
#   __NAME_BLOCK__    the card's own hostname: (with manage_etc_hosts: true),
#                     or preserve_hostname: true when the card has none. Not
#                     both: cloud-init ignores hostname: under
#                     preserve_hostname, which is why the old fixed
#                     preserve_hostname line renamed every fresh card to the
#                     image default.
__NAME_BLOCK__
ssh_deletekeys: false
# Create the groups BEFORE the user (cloud-init's user step fails on a group
# that does not exist). Idempotent where the image already has them, and
# docs/PI-SETUP.md section 3 declares the same three on a fresh card.
groups:
  - gpio
  - i2c
  - spi
users:
  - name: ubuntu
    gecos: wildsync camera node
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: false
    passwd: __PASSWD_HASH__
    groups: [adm, sudo, plugdev, video, dialout, gpio, i2c, spi]
    ssh_authorized_keys:
      - __CARD_KEY__
      - __HOST_KEY__
ssh_pwauth: true
chpasswd:
  expire: false
runcmd:
  # Clock topology for N nodes with no internet at sea. Every node gets the
  # SAME config: the GNSS Compass (GNSS_NTP, stratum 1 on GPS, preferred),
  # and behind it a full mesh of chrony peers plus an orphan local reference,
  # so that with the Compass off chrony elects one master by comparing NTP
  # reference IDs (which are the nodes' own IPv4 addresses) - .201 holds it
  # while it is up and the group re-elects the next-lowest address on its own
  # if it is not. Nothing below names a camera: adding cam4 is one entry in
  # SLOTS, no logic change.
  #
  # Replaces the two-node if/else ("peer = the other one"), which has no
  # meaning with a third camera. Free-running, the nodes measured 16.8 ms
  # apart against a 10 ms pair budget; peered in orphan mode, 0.6 ms; on the
  # Compass they share GPS time with the host (deploy.sh mac / jetson point
  # the host at the same server), which is what removes the host offset rigd
  # otherwise has to measure and correct for.
  #
  # The full mesh is what survives node loss. A star pointed at .201 leaves the
  # survivors free-running when .201 drops — that is the 16.8 ms failure.
  #
  # Wrapped in ( … ): cloud-init concatenates every runcmd entry into ONE
  # /bin/sh script, so a bare `set -eu` / `exit` here would silently truncate
  # anything a later edit appends after it.
  - |
    ( set -eu
      SUBNET=192.168.1
      SLOTS="1 2 3"        # pi-camN <-> $SUBNET.$((200+N)).  cam4: add "4".
      GNSS_NTP=192.168.1.60   # the GNSS Compass; deploy.sh's NTP_SERVER - keep them equal
      CONF=/etc/chrony/conf.d/10-wildsync.conf
      GNSS_CONF=/etc/chrony/conf.d/20-wildsync-gnss.conf

      n="$(hostname -s)"; n="${n#pi-cam}"
      case "$n" in ''|*[!0-9]*)
        # Card not named (no hostname: on it, so preserve_hostname keeps the
        # image default): fall back to this node's WIRED address, which is what
        # the election compares anyway. en*/eth* only — the rig switch and the
        # Starlink Wi-Fi both live on 192.168.1.0/24 and wlan0 is not the rig.
        n="$(ip -4 -o addr show | awk -v s="$SUBNET." '$2 ~ /^(en|eth)/ {split($4,a,"/"); if (index(a[1],s)==1){split(a[1],b,"."); print b[4]-200; exit}}')" ;;
      esac
      case " $SLOTS " in
        *" $n "*) : ;;
        *) echo "wildsync: $(hostname -s) is not a rig node slot ($SLOTS) — chrony left as-is" >&2; exit 0 ;;
      esac

      mkdir -p /etc/chrony/conf.d
      { echo "# wildsync clock topology — generated $(date -Is) on $(hostname -s)"
        echo "# source: deploy/pi-resync/user-data.template — do not hand-edit"
        for i in $SLOTS; do
          [ "$i" = "$n" ] || printf 'peer %s.%s iburst minpoll 4 maxpoll 6\n' "$SUBNET" "$((200+i))"
        done
        echo 'local stratum 10 orphan'
        echo "allow $SUBNET.0/24"
        echo 'makestep 1 -1'
      } > "$CONF"
      # The reference. Same file, same content as `deploy.sh clock` writes.
      { echo "# wildsync: the rig's GNSS Compass - a stratum-1 GPS NTP server on the rig switch."
        echo "# generated $(date -Is) by the card step; deploy.sh clock writes the same - do not hand-edit"
        echo "server $GNSS_NTP iburst minpoll 4 maxpoll 6 prefer"
      } > "$GNSS_CONF"
      # Ubuntu's chrony.conf says `makestep 1 3` AFTER `confdir`, so it wins
      # over the drop-in above and after three updates the node may never step
      # again - a node that peered a wrong neighbour before the Compass
      # answered would then be stuck days off. Always step a >1 s error.
      if grep -q '^[[:space:]]*makestep[[:space:]]' /etc/chrony/chrony.conf; then
        sed -i 's/^[[:space:]]*makestep[[:space:]].*/makestep 1 -1/' /etc/chrony/chrony.conf
      else
        echo 'makestep 1 -1' >> /etc/chrony/chrony.conf
      fi

      # Real time whenever the boat has internet: the Ubuntu pool lines live in
      # /etc/chrony/chrony.conf (confdir pulls this drop-in in alongside them)
      # and are deliberately NOT touched. Pool servers are stratum 2, they beat
      # the stratum-10 orphan on every node at once, and when they go
      # unreachable at sea the orphan takes back over. Re-add the pool only if
      # an earlier hand-edit stripped the base config.
      grep -qs '^[[:space:]]*\(pool\|server\)[[:space:]]' /etc/chrony/chrony.conf ||
        echo 'pool ntp.ubuntu.com iburst maxsources 4' >> "$CONF"

      # Supersede every drop-in that named ONE master: 10-jetson.conf (this
      # file's two-node ancestor) and wildsync.conf, which earlier versions of
      # `deploy.sh provision` wrote, pointing at the ssh client with `prefer`
      # (a Mac host is explicitly not a chrony master). The current provision
      # step removes wildsync.conf itself.
      rm -f /etc/chrony/conf.d/10-jetson.conf /etc/chrony/conf.d/wildsync.conf
      # Bring the replacement up BEFORE surrendering the working clock, and
      # bail out entirely if chrony is not installed. The old order - disable
      # timesyncd, then restart chrony - left a node with NO time discipline at
      # all whenever chrony was missing, on a rig whose whole value is a 10 ms
      # pair budget. deploy.sh carries the same fix; they must not diverge.
      command -v chronyd >/dev/null 2>&1 || {
        echo "wildsync: chrony not installed - leaving systemd-timesyncd up" >&2
        exit 0; }
      systemctl restart chrony
      if [ "$(systemctl is-active chrony)" = active ]; then
        systemctl disable --now systemd-timesyncd >/dev/null 2>&1 || true
      else
        echo "wildsync: chrony did not start - leaving systemd-timesyncd up" >&2
      fi
      mkdir -p /var/lib/wildsync
      echo "clock $(date -Is) slot=$n slots=$SLOTS" >> /var/lib/wildsync/.provisioned
    ) || echo "wildsync: chrony topology step FAILED" >&2

# Verify per node — all three must print the SAME Reference ID, which is the
# one-line proof the group has exactly one master (two distinct refids is a
# split; rigd's node_clock_skew, not chronyc, is the detector for that). With
# the Compass up that is its address, at stratum 2:
#   ssh ubuntu@192.168.1.201 chronyc tracking   # Ref ID C0A8013C (192.168.1.60)  Stratum 2
#   ssh ubuntu@192.168.1.202 chronyc tracking   # Ref ID C0A8013C (192.168.1.60)  Stratum 2
# and with it off, the orphan master's:
#   ssh ubuntu@192.168.1.201 chronyc tracking   # Ref ID C0A801C9 (.201)  Stratum 10
#   ssh ubuntu@192.168.1.202 chronyc tracking   # Ref ID C0A801C9 (.201)  Stratum 11
#   ssh ubuntu@192.168.1.203 chronyc tracking   # Ref ID C0A801C9 (.201)  Stratum 11
#
# Known gaps, in the order they will bite:
#   * A node still carrying a wildsync.conf from an earlier `deploy.sh
#     provision` (`server <ssh client IP> iburst prefer`) would abandon the
#     peer group for that host's clock the moment something there answers NTP —
#     a common-mode offset that node_clock_skew cannot see by construction (the
#     187 ms / ~60 ppm Mac failure). Current `provision` removes the file, and
#     this card step does too. Under a Jetson host, `deploy.sh node` run from it
#     writes 20-wildsync-host.conf deliberately; that one is intended.
#   * Slot identity is now a contract: hostname pi-camN implies 192.168.1.(200+N).
#     A node must already hold its address before this runs; a never-named card
#     whose address is not yet right falls through to the wired-IP fallback,
#     bails out, and leaves chrony untouched. Re-run once the address settles.
#   * Dockside with internet up, pair skew gets WORSE — three nodes can take
#     three different pool servers over an asymmetric Starlink path, exactly
#     what deploy.sh's own comment warns about. The survey design point is no
#     upstream; if a survey must run with internet live, `chronyc offline
#     192.168.1.0/0` drops the pool and leaves the LAN peers online.
#   * The refid chrony compares comes from one of the host's own addresses, and
#     the rig switch and Starlink Wi-Fi share 192.168.1.0/24 — a node that
#     associates to the boat's AP has two addresses on that /24 and its refid
#     can move. A node whose refid is not its wired .20x is the one to look at.
#   * `allow 192.168.1.0/24` lets any host on that /24 query a node for time.
#     It only serves time, never accepts it — noise, not exposure. Tighten to
#     the three node addresses if that matters.
#   * After a master handover the follower slews, not steps (makestep 1.0 3
#     covers only the first three updates and these offsets are milliseconds).
#     Give it a minute before trusting the 10 ms budget; rigd needs 3
#     consecutive scans to raise or clear node_clock_skew anyway.
#   * `orphan` needs chrony >= 3.5; noble ships 4.x, so this only matters if a
#     node is ever imaged with something older.
