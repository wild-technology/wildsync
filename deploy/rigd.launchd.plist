<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent for rigd on a macOS host — the systemd unit's equivalent
     (deploy/rigd.service is the Jetson twin). Install:

       sed "s|__REPO__|$(pwd)|g; s|__HOME__|$HOME|g" deploy/rigd.launchd.plist \
         > ~/Library/LaunchAgents/org.wildtechnology.wildsync.rigd.plist
       launchctl bootstrap gui/$(id -u) \
         ~/Library/LaunchAgents/org.wildtechnology.wildsync.rigd.plist

     Manage:
       launchctl kickstart -k gui/$(id -u)/org.wildtechnology.wildsync.rigd   # restart
       launchctl bootout   gui/$(id -u)/org.wildtechnology.wildsync.rigd     # stop+remove

     KeepAlive gives the same crash-restart discipline as Restart=always;
     rigd finalises an active run on SIGTERM either way. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.wildtechnology.wildsync.rigd</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>-u</string>
    <string>__REPO__/rig/rigd.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__/rig</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Interactive exempts rigd from App Nap / timer coalescing. As a default
       background agent, sleeps between shots wake LATE: measured 2026-08-20,
       a 2 s capture cadence ran 99/141 shots late (35.5 ms interval jitter)
       while a 0.5 s cadence — sleeps too short to coalesce — ran 14/337 late
       (6.1 ms). The capture scheduler needs real-time-ish wakeups. -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ThrottleInterval</key>
  <integer>3</integer>
  <!-- SIGKILL budget after SIGTERM. launchd's default is 20 s, and a stop
       that lands mid-transect against a wedged node can spend longer than
       that finalising: RunManager.stop waits cap_thread.join(6), then a 6 s
       grace loop that never clears while pulled < fired, then w.join(8)
       behind a pull that can sit in a 30 s http_bytes. rigd was killed before
       run.json was marked final, so `launchctl kickstart -k` during a run
       (FIELD-RUN's own restart recipe) reliably produced an interrupted
       manifest that the next start had to rebuild. rigd now caps its own
       finalisation at Rig.STOP_DEADLINE_S = 12 s so it always exits inside
       the budget; this raises the budget too, so an ordinary slow-but-healthy
       stop is never cut short in the first place. -->
  <key>ExitTimeOut</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/rig/rigd-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/rig/rigd-launchd.log</string>
</dict>
</plist>
